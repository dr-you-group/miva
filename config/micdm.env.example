# MI-CDM DB 접속 정보. $MIVAL_HOME/config/micdm.env 로 복사해서 채운다.
# 이 파일의 값은 로그와 manifest에 남지 않는다 (파일 경로만 기록됨).
# PostgreSQL / SQL Server 공통. 어느 DB인지는 study.yaml의 retrieve.dbms 로 정한다.
# 값 뒤에 주석을 붙이지 않는다 (주석은 # 로 시작하는 별도 줄에).
# DB_PORT: PostgreSQL 기본 5432, SQL Server 기본 1433
DB_HOST=localhost
DB_PORT=5432
DB_NAME=micdm
DB_USER=mival_reader
DB_PASSWORD=change-me
